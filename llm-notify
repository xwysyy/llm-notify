#!/usr/bin/env python3
"""llm-notify v3: presence-gated Feishu receipts for Claude Code and Codex CLI.

Decision model: never disturb a present user, tell an absent user
immediately, never resend what the user has already seen.
"""

import base64
import hashlib
import hmac
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.request

try:
    import fcntl
except ImportError:  # non-POSIX; watcher locking degrades to spawn-per-event
    fcntl = None

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
CONFIG_PATH = os.environ.get("LLM_NOTIFY_CONFIG") or os.path.join(SCRIPT_DIR, "config.json")
STATE_DIR = os.environ.get("LLM_NOTIFY_STATE_DIR") or os.path.join(SCRIPT_DIR, "state")
SESSIONS_DIR = os.path.join(STATE_DIR, "sessions")
QUEUE_DIR = os.path.join(STATE_DIR, "queue")
PRESENCE_PATH = os.path.join(STATE_DIR, "presence.json")
WIN_IDLE_CACHE = os.path.join(STATE_DIR, "win_idle.json")
LOG_PATH = os.path.join(STATE_DIR, "log.jsonl")
WATCHER_LOCK = os.path.join(STATE_DIR, "watcher.lock")

SAFE_ID_RE = re.compile(r"[^a-zA-Z0-9_.@+-]")
SENSITIVE_WORD_RE = re.compile(
    r"(secret|token|password|passwd|credential|cookie|session|vault)",
    re.IGNORECASE,
)
SENSITIVE_EXTS = (".pem", ".p12", ".pfx", ".key")
SENSITIVE_NAMES = {
    ".env",
    ".aws",
    ".kube",
    ".npmrc",
    ".pypirc",
    ".netrc",
    "id_rsa",
    "id_ed25519",
    "credentials",
    "kubeconfig",
}
EXPLICIT_NOTIFY_RE = re.compile(
    r"(完成后通知我|飞书提醒|通知我|notify\s+me|notify\s+when\s+done)",
    re.IGNORECASE,
)

INTERVENTION_TYPES = {
    "permission_prompt": "权限确认",
    "elicitation_dialog": "MCP 交互确认",
}

EDIT_TOOLS = ("Edit", "Write", "MultiEdit", "NotebookEdit")

WATCH_POLL = max(1, int(os.environ.get("LLM_NOTIFY_POLL") or 30))
WIN_IDLE_CACHE_TTL = 15
WIN_IDLE_PS = (
    "Add-Type 'using System;using System.Runtime.InteropServices;"
    "public class LNIdle{"
    "[DllImport(\"user32.dll\")]public static extern bool GetLastInputInfo(ref LNLast l);"
    "[StructLayout(LayoutKind.Sequential)]public struct LNLast{public uint cbSize;public uint dwTime;}"
    "public static uint Get(){LNLast l=new LNLast();"
    "l.cbSize=(uint)Marshal.SizeOf(typeof(LNLast));GetLastInputInfo(ref l);"
    "return ((uint)Environment.TickCount-l.dwTime)/1000u;}}'"
    ";[LNIdle]::Get()"
)

LOG_MAX_BYTES = 1024 * 1024
LOG_KEEP_LINES = 2000
SESSION_GC_AGE = 7 * 86400
GIT_STATUS_CAP = 5000


def now_ts():
    return time.time()


def safe_state_name(value):
    name = SAFE_ID_RE.sub("_", str(value or "unknown"))
    return name[:160] if name else "unknown"


def ensure_state_dirs():
    for path in (STATE_DIR, SESSIONS_DIR, QUEUE_DIR):
        os.makedirs(path, mode=0o700, exist_ok=True)
        try:
            os.chmod(path, 0o700)
        except OSError:
            pass


def read_json(path, default=None):
    if not os.path.exists(path):
        return default
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return default


def write_json_atomic(path, data):
    ensure_state_dirs()
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    tmp = os.path.join(directory, f".{os.path.basename(path)}.{os.getpid()}.tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2, sort_keys=True)
        f.write("\n")
    try:
        os.chmod(tmp, 0o600)
    except OSError:
        pass
    os.replace(tmp, path)


def read_stdin_json():
    data = sys.stdin.read()
    if not data.strip():
        return {}
    try:
        return json.loads(data)
    except json.JSONDecodeError:
        print(f"llm-notify: invalid stdin JSON (len={len(data)})", file=sys.stderr)
        return {}


def log_decision(decision, **fields):
    ensure_state_dirs()
    record = {"ts": round(now_ts(), 3), "decision": decision}
    record.update(fields)
    line = json.dumps(record, ensure_ascii=False, sort_keys=True)
    try:
        if os.path.exists(LOG_PATH) and os.path.getsize(LOG_PATH) > LOG_MAX_BYTES:
            with open(LOG_PATH, "r", encoding="utf-8", errors="replace") as f:
                tail = f.readlines()[-LOG_KEEP_LINES:]
            with open(LOG_PATH, "w", encoding="utf-8") as f:
                f.writelines(tail)
        with open(LOG_PATH, "a", encoding="utf-8") as f:
            f.write(line + "\n")
        os.chmod(LOG_PATH, 0o600)
    except OSError:
        pass


# --- config ---


def default_config():
    return {
        "webhook": "",
        "secret": "",
        "keyword": "[AI通知]",
        "machine_label": "machine",
        "presence": {"away_threshold": 120, "windows_input": True},
        "notify": {"min_elapsed": 45, "queue_ttl": 1800, "intervention_cooldown": 600},
        "content": {
            "max_changed_files": 10,
            "path_mode": "project",
            "include_privacy_note": True,
        },
    }


def load_config(required=True):
    if not os.path.exists(CONFIG_PATH):
        if required:
            print(f"配置文件不存在: {CONFIG_PATH}", file=sys.stderr)
            print("请先运行: llm-notify init", file=sys.stderr)
            sys.exit(1)
        return default_config()

    try:
        os.chmod(CONFIG_PATH, 0o600)
    except OSError:
        pass

    with open(CONFIG_PATH, "r", encoding="utf-8") as f:
        cfg = json.load(f)

    if required and not cfg.get("webhook"):
        print("配置缺少 webhook", file=sys.stderr)
        sys.exit(1)

    defaults = default_config()
    for key in ("keyword", "machine_label"):
        cfg.setdefault(key, defaults[key])
    for section in ("presence", "notify", "content"):
        cfg.setdefault(section, {})
        for key, value in defaults[section].items():
            cfg[section].setdefault(key, value)
    cfg["presence"]["away_threshold"] = int(cfg["presence"]["away_threshold"])
    cfg["notify"]["min_elapsed"] = int(cfg["notify"]["min_elapsed"])
    cfg["notify"]["queue_ttl"] = int(cfg["notify"]["queue_ttl"])
    cfg["notify"]["intervention_cooldown"] = int(cfg["notify"]["intervention_cooldown"])
    cfg["content"]["max_changed_files"] = int(cfg["content"]["max_changed_files"])
    return cfg


# --- Feishu ---


def send_feishu(config, title, content):
    webhook = config["webhook"]
    secret = config.get("secret", "")
    keyword = config.get("keyword", "")

    full_text = f"{title}\n{content}"
    if keyword and keyword not in full_text:
        title = f"{keyword} {title}"

    body = {"msg_type": "text", "content": {"text": f"{title}\n{content}"}}

    if secret:
        timestamp = str(int(time.time()))
        string_to_sign = f"{timestamp}\n{secret}"
        hmac_code = hmac.new(
            key=string_to_sign.encode("utf-8"),
            msg=b"",
            digestmod=hashlib.sha256,
        ).digest()
        body["timestamp"] = timestamp
        body["sign"] = base64.b64encode(hmac_code).decode("utf-8")

    data = json.dumps(body).encode("utf-8")
    req = urllib.request.Request(
        webhook,
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=5) as resp:
        result = json.loads(resp.read().decode("utf-8"))
        if result.get("code", 0) != 0:
            print(f"飞书返回错误: {result}", file=sys.stderr)
            return False
    return True


def try_send(config, title, content):
    last_error = None
    for attempt in range(2):
        try:
            return send_feishu(config, title, content)
        except Exception as e:
            last_error = e
            if attempt == 0:
                time.sleep(1)
    print(f"llm-notify: 发送失败: {last_error}", file=sys.stderr)
    return False


# --- presence ---

_IS_WSL = None


def is_wsl():
    global _IS_WSL
    if _IS_WSL is None:
        try:
            with open("/proc/version", "r", encoding="utf-8", errors="replace") as f:
                _IS_WSL = "microsoft" in f.read().lower()
        except OSError:
            _IS_WSL = False
    return _IS_WSL


def input_last_active():
    data = read_json(PRESENCE_PATH, {}) or {}
    try:
        return float(data.get("global_last_human_input_at") or 0)
    except (TypeError, ValueError):
        return 0.0


def record_human_input(ts):
    write_json_atomic(PRESENCE_PATH, {"global_last_human_input_at": ts})


def tty_last_active():
    latest = 0.0
    try:
        names = os.listdir("/dev/pts")
    except OSError:
        return 0.0
    for name in names:
        if not name.isdigit():
            continue
        try:
            atime = os.stat(os.path.join("/dev/pts", name)).st_atime
        except OSError:
            continue
        latest = max(latest, atime)
    return latest


def windows_last_active(config):
    if not config.get("presence", {}).get("windows_input", True) or not is_wsl():
        return None
    now = now_ts()
    cache = read_json(WIN_IDLE_CACHE, {}) or {}
    checked = float(cache.get("checked_at") or 0)
    if now - checked < WIN_IDLE_CACHE_TTL:
        idle = cache.get("idle_seconds")
        return checked - float(idle) if idle is not None else None

    exe = shutil.which("powershell.exe")
    idle = None
    if exe:
        try:
            result = subprocess.run(
                [exe, "-NoProfile", "-NonInteractive", "-Command", WIN_IDLE_PS],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=3,
            )
            if result.returncode == 0:
                idle = float(result.stdout.strip())
        except (OSError, subprocess.SubprocessError, ValueError):
            idle = None
    write_json_atomic(WIN_IDLE_CACHE, {"checked_at": now, "idle_seconds": idle})
    return now - idle if idle is not None else None


def presence_sources(config):
    sources = {"input": input_last_active(), "tty": tty_last_active()}
    win = windows_last_active(config)
    if win is not None:
        sources["windows"] = win
    return sources


def presence_idle(config):
    fake = os.environ.get("LLM_NOTIFY_FAKE_IDLE")
    if fake is not None:
        return float(fake)
    last = max(presence_sources(config).values())
    if last <= 0:
        return float("inf")
    return max(0.0, now_ts() - last)


def is_away(config):
    return presence_idle(config) >= config["presence"]["away_threshold"]


# --- tool / event helpers ---


def norm_event(value):
    return re.sub(r"[^a-z0-9]", "", str(value or "").lower())


def get_event_name(info):
    return (
        info.get("hook_event_name")
        or info.get("event_name")
        or info.get("event")
        or ""
    )


def detect_tool(info, arg_tool=None):
    if arg_tool in ("claude", "codex"):
        return arg_tool
    explicit = str(info.get("tool") or info.get("source") or "").lower()
    if explicit in ("claude", "claude-code", "claude_code"):
        return "claude"
    if explicit == "codex":
        return "codex"
    if info.get("thread-id") or info.get("thread_id") or info.get("turn-id"):
        return "codex"
    if info.get("transcript_path") or info.get("permission_mode"):
        return "codex" if ".codex" in str(info.get("transcript_path") or "") else "claude"
    return "unknown"


def extract_session_id(info):
    return str(
        info.get("session_id")
        or info.get("session-id")
        or info.get("thread_id")
        or info.get("thread-id")
        or "unknown"
    )


def extract_cwd(info):
    cwd = info.get("cwd") or os.getcwd()
    return os.path.abspath(os.path.expanduser(str(cwd)))


def extract_prompt(info):
    value = info.get("prompt") or ""
    return value if isinstance(value, str) else ""


def tool_name_from_info(info):
    name = info.get("tool_name") or info.get("name") or ""
    if not name and isinstance(info.get("tool"), dict):
        name = info["tool"].get("name") or ""
    return str(name)


def tool_input_from_info(info):
    value = info.get("tool_input") or info.get("input") or info.get("arguments") or {}
    if isinstance(value, str):
        try:
            parsed = json.loads(value)
            return parsed if isinstance(parsed, dict) else {}
        except json.JSONDecodeError:
            return {}
    return value if isinstance(value, dict) else {}


def tool_label(tool):
    if tool == "claude":
        return "Claude Code"
    if tool == "codex":
        return "Codex"
    return "AI"


def classify_stop_failure(info):
    text = str(info.get("error") or info.get("error_type") or info.get("matcher") or "")
    low = text.lower()
    if "rate" in low or "limit" in low:
        return "API 错误: rate_limit"
    if "auth" in low or "permission" in low:
        return "API 错误: auth_or_permission"
    if "network" in low or "timeout" in low:
        return "API 错误: network"
    return "API 或 StopFailure"


# --- git ---


def run_git(cwd, args, binary=False, timeout=3):
    try:
        result = subprocess.run(
            ["git", *args],
            cwd=cwd,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=not binary,
            timeout=timeout,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0:
        return None
    return result.stdout


def parse_porcelain_z(data):
    if not data:
        return {}
    if isinstance(data, str):
        data = data.encode("utf-8", "replace")
    status = {}
    entries = [entry for entry in data.split(b"\0") if entry]
    skip_next = False
    for entry in entries:
        if skip_next:
            skip_next = False
            continue
        if len(entry) < 4:
            continue
        xy = entry[:2].decode("ascii", "replace")
        path = entry[3:].decode("utf-8", "replace")
        if path:
            status[path] = xy
        if xy[0] in ("R", "C") or xy[1] in ("R", "C"):
            skip_next = True
    return status


def git_snapshot(cwd):
    root = run_git(cwd, ["rev-parse", "--show-toplevel"], timeout=2)
    if not root:
        return {}
    root = root.strip()
    head = run_git(root, ["rev-parse", "HEAD"], timeout=2)
    raw = run_git(
        root,
        ["status", "--porcelain=v1", "-z", "--untracked-files=all"],
        binary=True,
        timeout=2,
    )
    status = parse_porcelain_z(raw) if raw is not None else None
    if status is not None and len(status) > GIT_STATUS_CAP:
        status = None  # huge dirty worktree: summary would be meaningless
    return {
        "git_root": root,
        "git_head_at_start": (head or "").strip(),
        "git_status_at_start": status,
    }


def is_sensitive_path(path):
    parts = [p for p in re.split(r"[\/]+", str(path or "")) if p]
    for part in parts:
        low = part.lower()
        if low in SENSITIVE_NAMES or low.startswith(".env."):
            return True
        if low.endswith(SENSITIVE_EXTS) or SENSITIVE_WORD_RE.search(low):
            return True
    return False


def display_files(paths, max_files):
    shown = []
    hidden = 0
    for item in paths[:max_files]:
        if is_sensitive_path(item):
            hidden += 1
        else:
            shown.append(item)
    if hidden:
        shown.append(f"<敏感路径已隐藏> ({hidden})")
    return shown


def changed_files_summary(snap, config):
    max_files = config["content"]["max_changed_files"]
    git_root = snap.get("git_root")
    start = snap.get("git_status_at_start")
    summary = {
        "files": [],
        "preexisting_dirty_count": 0,
        "cleaned_count": 0,
        "more_count": 0,
        "head_changed": False,
        "status_failed": False,
    }

    if git_root and start is not None:
        end_raw = run_git(
            git_root,
            ["status", "--porcelain=v1", "-z", "--untracked-files=all"],
            binary=True,
            timeout=3,
        )
        if end_raw is None:
            summary["status_failed"] = True
            return summary
        end = parse_porcelain_z(end_raw)
        end_head = (run_git(git_root, ["rev-parse", "HEAD"]) or "").strip()
        summary["head_changed"] = bool(
            snap.get("git_head_at_start") and end_head != snap.get("git_head_at_start")
        )

        start_keys = set(start)
        end_keys = set(end)
        new_dirty = sorted(end_keys - start_keys)
        changed_status = sorted(
            path for path in (start_keys & end_keys) if start.get(path) != end.get(path)
        )
        unchanged = [path for path in (start_keys & end_keys) if start.get(path) == end.get(path)]
        cleaned = sorted(start_keys - end_keys)

        files = new_dirty + changed_status
        summary["files"] = display_files(files, max_files)
        summary["more_count"] = max(0, len(files) - max_files)
        summary["preexisting_dirty_count"] = len(unchanged)
        summary["cleaned_count"] = len(cleaned)
        return summary

    if git_root and start is None:
        summary["status_failed"] = True
        return summary

    candidates = sorted(set(snap.get("file_candidates") or []))
    summary["files"] = display_files(candidates, max_files)
    summary["more_count"] = max(0, len(candidates) - max_files)
    return summary


# --- sessions ---


def session_path(tool, session_id):
    return os.path.join(SESSIONS_DIR, safe_state_name(f"{tool}__{session_id}") + ".json")


def load_session(tool, session_id):
    default = {
        "tool": tool,
        "session_id": session_id,
        "last_input_at": 0,
        "last_activity_at": 0,
        "last_intervention_sent_at": 0,
        "turn": None,
    }
    data = read_json(session_path(tool, session_id))
    if not isinstance(data, dict):
        return default
    for key, value in default.items():
        data.setdefault(key, value)
    return data


def save_session(session):
    write_json_atomic(session_path(session["tool"], session["session_id"]), session)


def gc_sessions():
    if not os.path.isdir(SESSIONS_DIR):
        return
    cutoff = now_ts() - SESSION_GC_AGE
    try:
        names = os.listdir(SESSIONS_DIR)
    except OSError:
        return
    for name in names:
        path = os.path.join(SESSIONS_DIR, name)
        try:
            if os.path.getmtime(path) < cutoff:
                os.unlink(path)
        except OSError:
            continue


# --- queue ---


def queue_entries():
    if not os.path.isdir(QUEUE_DIR):
        return []
    entries = []
    try:
        names = sorted(os.listdir(QUEUE_DIR))
    except OSError:
        return []
    for name in names:
        if not name.endswith(".json"):
            continue
        data = read_json(os.path.join(QUEUE_DIR, name))
        if isinstance(data, dict) and data.get("id"):
            entries.append(data)
    return entries


def queue_entry_path(entry_id):
    return os.path.join(QUEUE_DIR, safe_state_name(entry_id) + ".json")


def remove_entry(entry_id):
    try:
        os.unlink(queue_entry_path(entry_id))
    except OSError:
        pass


def save_entry(entry):
    write_json_atomic(queue_entry_path(entry["id"]), entry)


def enqueue(config, kind, tool, session_id, reason="", snapshot=None):
    created = now_ts()
    if kind == "intervention":
        for entry in queue_entries():
            if (
                entry.get("kind") == "intervention"
                and entry.get("tool") == tool
                and entry.get("session_id") == session_id
            ):
                return entry  # one pending intervention per session is enough
    entry = {
        "id": safe_state_name(f"{kind}__{tool}__{session_id}__{int(created * 1000)}"),
        "kind": kind,
        "tool": tool,
        "session_id": session_id,
        "created_at": created,
        "expires_at": created + config["notify"]["queue_ttl"],
        "attempts": 0,
        "reason": reason,
        "snapshot": snapshot or {},
    }
    save_entry(entry)
    spawn_watcher()
    return entry


def cancel_session_entries(tool, session_id, kinds, why):
    removed = 0
    for entry in queue_entries():
        if entry.get("tool") != tool or entry.get("session_id") != session_id:
            continue
        if entry.get("kind") not in kinds:
            continue
        remove_entry(entry["id"])
        removed += 1
        log_decision(
            "cancelled",
            kind=entry.get("kind"),
            tool=tool,
            session=session_id,
            reason=why,
        )
    return removed


def spawn_watcher():
    if os.environ.get("LLM_NOTIFY_NO_SPAWN") == "1":
        return
    try:
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "watch"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError:
        pass


# --- rendering ---


def fmt_duration(seconds):
    if seconds is None:
        return "未知"
    total = max(0, int(seconds))
    h, remainder = divmod(total, 3600)
    m, s = divmod(remainder, 60)
    if h:
        return f"{h}小时{m}分{s}秒"
    if m:
        return f"{m}分{s}秒"
    return f"{s}秒"


def project_label(snap):
    root = snap.get("git_root") or snap.get("cwd") or ""
    name = os.path.basename(os.path.normpath(root)) if root else "unknown"
    return name or "unknown"


def privacy_note(config):
    if config["content"].get("include_privacy_note", True):
        return "隐私: 未发送 prompt、回复正文、命令输出、diff 内容"
    return ""


def render_completion(config, snap, trigger):
    elapsed = None
    if snap.get("started_at") and snap.get("completed_at"):
        elapsed = float(snap["completed_at"]) - float(snap["started_at"])

    summary = changed_files_summary(snap, config)
    lines = [
        f"工具: {tool_label(snap.get('tool'))}",
        f"机器: {config.get('machine_label', 'machine')}",
        f"项目: {project_label(snap)}",
        f"耗时: {fmt_duration(elapsed)}",
        f"触发: {trigger}",
    ]

    files = summary["files"]
    if files:
        lines.append("改动文件:")
        lines.extend(f"- {path}" for path in files)
        if summary["more_count"]:
            lines.append(f"- 另有 {summary['more_count']} 个文件")
    else:
        lines.append("改动文件: 未检测到或不可判定")

    notes = []
    if summary["preexisting_dirty_count"]:
        notes.append(f"任务开始前已有脏文件 {summary['preexisting_dirty_count']} 个")
    if summary["cleaned_count"]:
        notes.append(f"任务期间清理了既有脏文件 {summary['cleaned_count']} 个")
    if summary["head_changed"]:
        notes.append("HEAD 已变化，工作区摘要不代表全部改动")
    if summary["status_failed"]:
        notes.append("Git 状态不可判定")
    if notes:
        lines.append("备注: " + "；".join(notes))

    lines.append(
        f"执行: 工具 {int(snap.get('tool_count', 0))} 次，失败 {int(snap.get('failure_count', 0))} 次"
    )
    note = privacy_note(config)
    if note:
        lines.append(note)
    return "\n".join(lines)


def render_intervention(config, tool, reason, snap=None):
    lines = [f"工具: {tool_label(tool)}", f"机器: {config.get('machine_label', 'machine')}"]
    if snap:
        lines.append(f"项目: {project_label(snap)}")
    lines.append(f"事件: {reason}")
    note = privacy_note(config)
    if note:
        lines.append(note)
    return "\n".join(lines)


def render_batch(config, entries):
    lines = [f"机器: {config.get('machine_label', 'machine')}"]
    for i, entry in enumerate(entries, 1):
        snap = entry.get("snapshot") or {}
        label = tool_label(entry.get("tool"))
        proj = project_label(snap)
        if entry.get("kind") == "completion":
            elapsed = None
            if snap.get("started_at") and snap.get("completed_at"):
                elapsed = float(snap["completed_at"]) - float(snap["started_at"])
            summary = changed_files_summary(snap, config)
            nfiles = len([f for f in summary["files"] if not f.startswith("<敏感")])
            nfiles += summary["more_count"]
            item = f"{i}. {label} 任务完成 · {proj} · {fmt_duration(elapsed)} · 改动 {nfiles} 个文件"
            failures = int(snap.get("failure_count", 0))
            if failures:
                item += f" · 失败 {failures} 次"
        else:
            item = f"{i}. {label} 需要处理 · {proj} · {entry.get('reason') or '需要用户处理'}"
        lines.append(item)
    note = privacy_note(config)
    if note:
        lines.append(note)
    return "\n".join(lines)


# --- sending ---


def send_completion_now(config, snap, trigger):
    title = f"{tool_label(snap.get('tool'))} 任务完成"
    return try_send(config, title, render_completion(config, snap, trigger))


def send_intervention_now(config, tool, reason, snap=None):
    title = f"{tool_label(tool)} 需要处理"
    return try_send(config, title, render_intervention(config, tool, reason, snap))


def mark_intervention_sent(tool, session_id):
    session = load_session(tool, session_id)
    session["last_intervention_sent_at"] = now_ts()
    save_session(session)


def send_batch(config, entries):
    if len(entries) == 1:
        entry = entries[0]
        if entry["kind"] == "completion":
            ok = send_completion_now(config, entry["snapshot"], "离开后送达")
        else:
            ok = send_intervention_now(
                config, entry.get("tool"), entry.get("reason") or "需要用户处理", entry.get("snapshot")
            )
    else:
        title = f"离开期间 {len(entries)} 项更新"
        ok = try_send(config, title, render_batch(config, entries))
    if ok:
        for entry in entries:
            if entry["kind"] == "intervention":
                mark_intervention_sent(entry["tool"], entry["session_id"])
    return ok



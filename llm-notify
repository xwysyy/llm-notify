#!/usr/bin/env python3
"""llm-notify v4: presence-gated one-line Feishu alerts for Claude Code and Codex CLI.

Decision model: never disturb a present user, tell an absent user
immediately, never resend what the user has already seen.
Every message is a single line: working directory name plus a state word.
"""

import base64
import hashlib
import hmac
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request

try:
    import fcntl
except ImportError:  # non-POSIX; watcher locking degrades to spawn-per-event
    fcntl = None

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
CONFIG_PATH = os.environ.get("LLM_NOTIFY_CONFIG") or os.path.join(SCRIPT_DIR, "config.json")
STATE_DIR = os.environ.get("LLM_NOTIFY_STATE_DIR") or os.path.join(SCRIPT_DIR, "state")
SESSIONS_DIR = os.path.join(STATE_DIR, "sessions")
QUEUE_DIR = os.path.join(STATE_DIR, "queue")
PRESENCE_PATH = os.path.join(STATE_DIR, "presence.json")
WIN_IDLE_CACHE = os.path.join(STATE_DIR, "win_idle.json")
LOG_PATH = os.path.join(STATE_DIR, "log.jsonl")
WATCHER_LOCK = os.path.join(STATE_DIR, "watcher.lock")

SAFE_ID_RE = re.compile(r"[^a-zA-Z0-9_.@+-]")
EXPLICIT_NOTIFY_RE = re.compile(
    r"(完成后通知我|飞书提醒|通知我|notify\s+me|notify\s+when\s+done)",
    re.IGNORECASE,
)

# notification types that mean the agent is blocked on the user
INTERVENTION_TYPES = {
    "permission_prompt": "需确认",
    "elicitation_dialog": "需确认",
}

WATCH_POLL = max(1, int(os.environ.get("LLM_NOTIFY_POLL") or 30))
DEBOUNCE_CAP = 300  # oldest entry never waits longer than this for coalescing
WIN_IDLE_CACHE_TTL = 15
WIN_IDLE_PS = (
    "Add-Type 'using System;using System.Runtime.InteropServices;"
    "public class LNIdle{"
    "[DllImport(\"user32.dll\")]public static extern bool GetLastInputInfo(ref LNLast l);"
    "[StructLayout(LayoutKind.Sequential)]public struct LNLast{public uint cbSize;public uint dwTime;}"
    "public static uint Get(){LNLast l=new LNLast();"
    "l.cbSize=(uint)Marshal.SizeOf(typeof(LNLast));GetLastInputInfo(ref l);"
    "return ((uint)Environment.TickCount-l.dwTime)/1000u;}}'"
    ";[LNIdle]::Get()"
)

LOG_MAX_BYTES = 1024 * 1024
LOG_KEEP_LINES = 2000
SESSION_GC_AGE = 7 * 86400


def now_ts():
    return time.time()


def safe_state_name(value):
    name = SAFE_ID_RE.sub("_", str(value or "unknown"))
    return name[:160] if name else "unknown"


def ensure_state_dirs():
    for path in (STATE_DIR, SESSIONS_DIR, QUEUE_DIR):
        os.makedirs(path, mode=0o700, exist_ok=True)
        try:
            os.chmod(path, 0o700)
        except OSError:
            pass


def read_json(path, default=None):
    if not os.path.exists(path):
        return default
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return default


def write_json_atomic(path, data):
    ensure_state_dirs()
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    tmp = os.path.join(directory, f".{os.path.basename(path)}.{os.getpid()}.tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2, sort_keys=True)
        f.write("\n")
    try:
        os.chmod(tmp, 0o600)
    except OSError:
        pass
    os.replace(tmp, path)


def read_stdin_json():
    data = sys.stdin.read()
    if not data.strip():
        return {}
    try:
        return json.loads(data)
    except json.JSONDecodeError:
        print(f"llm-notify: invalid stdin JSON (len={len(data)})", file=sys.stderr)
        return {}


def log_decision(decision, **fields):
    ensure_state_dirs()
    record = {"ts": round(now_ts(), 3), "decision": decision}
    record.update(fields)
    line = json.dumps(record, ensure_ascii=False, sort_keys=True)
    try:
        if os.path.exists(LOG_PATH) and os.path.getsize(LOG_PATH) > LOG_MAX_BYTES:
            with open(LOG_PATH, "r", encoding="utf-8", errors="replace") as f:
                tail = f.readlines()[-LOG_KEEP_LINES:]
            with open(LOG_PATH, "w", encoding="utf-8") as f:
                f.writelines(tail)
        with open(LOG_PATH, "a", encoding="utf-8") as f:
            f.write(line + "\n")
        os.chmod(LOG_PATH, 0o600)
    except OSError:
        pass


# --- config ---


def default_config():
    return {
        "webhook": "",
        "secret": "",
        "keyword": "[AI通知]",
        "presence": {"away_threshold": 120, "windows_input": True},
        "notify": {
            "min_elapsed": 45,
            "queue_ttl": 1800,
            "intervention_cooldown": 600,
            "debounce": 60,
            "seen_grace": 180,
            "cache_ttl": 3600,
            "reply_reminders": [2400, 3000],
        },
    }


def load_config(required=True):
    if not os.path.exists(CONFIG_PATH):
        if required:
            print(f"配置文件不存在: {CONFIG_PATH}", file=sys.stderr)
            print("请先运行: llm-notify init", file=sys.stderr)
            sys.exit(1)
        return default_config()

    try:
        os.chmod(CONFIG_PATH, 0o600)
    except OSError:
        pass

    with open(CONFIG_PATH, "r", encoding="utf-8") as f:
        cfg = json.load(f)

    if required and not cfg.get("webhook"):
        print("配置缺少 webhook", file=sys.stderr)
        sys.exit(1)

    defaults = default_config()
    cfg.setdefault("keyword", defaults["keyword"])
    for section in ("presence", "notify"):
        cfg.setdefault(section, {})
        for key, value in defaults[section].items():
            cfg[section].setdefault(key, value)
    cfg["presence"]["away_threshold"] = int(cfg["presence"]["away_threshold"])
    for key in ("min_elapsed", "queue_ttl", "intervention_cooldown", "debounce", "seen_grace", "cache_ttl"):
        cfg["notify"][key] = int(cfg["notify"][key])
    cfg["notify"]["reply_reminders"] = [int(v) for v in cfg["notify"]["reply_reminders"]]
    return cfg


# --- Feishu ---


def send_feishu(config, text):
    webhook = config["webhook"]
    secret = config.get("secret", "")
    keyword = config.get("keyword", "")

    if keyword and keyword not in text:
        text = f"{keyword} {text}"

    body = {"msg_type": "text", "content": {"text": text}}

    if secret:
        timestamp = str(int(time.time()))
        string_to_sign = f"{timestamp}\n{secret}"
        hmac_code = hmac.new(
            key=string_to_sign.encode("utf-8"),
            msg=b"",
            digestmod=hashlib.sha256,
        ).digest()
        body["timestamp"] = timestamp
        body["sign"] = base64.b64encode(hmac_code).decode("utf-8")

    data = json.dumps(body).encode("utf-8")
    req = urllib.request.Request(
        webhook,
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=5) as resp:
        result = json.loads(resp.read().decode("utf-8"))
        if result.get("code", 0) != 0:
            print(f"飞书返回错误: {result}", file=sys.stderr)
            return False
    return True


def is_timeout_error(exc):
    if isinstance(exc, (TimeoutError, socket.timeout)):
        return True
    reason = getattr(exc, "reason", None)
    return isinstance(reason, (TimeoutError, socket.timeout))


def try_send(config, text):
    """Send once; retry only failures that certainly never delivered.

    A timeout is ambiguous (Feishu may have received the request), so it
    counts as delivered rather than risking a duplicate push.
    """
    last_error = None
    for attempt in range(2):
        try:
            return send_feishu(config, text)
        except Exception as e:
            if is_timeout_error(e):
                log_decision("send_ambiguous", error=str(e))
                return True
            last_error = e
            if attempt == 0:
                time.sleep(1)
    print(f"llm-notify: 发送失败: {last_error}", file=sys.stderr)
    return False


# --- presence ---

_IS_WSL = None


def is_wsl():
    global _IS_WSL
    if _IS_WSL is None:
        try:
            with open("/proc/version", "r", encoding="utf-8", errors="replace") as f:
                _IS_WSL = "microsoft" in f.read().lower()
        except OSError:
            _IS_WSL = False
    return _IS_WSL


def input_last_active():
    data = read_json(PRESENCE_PATH, {}) or {}
    try:
        return float(data.get("global_last_human_input_at") or 0)
    except (TypeError, ValueError):
        return 0.0


def record_human_input(ts):
    write_json_atomic(PRESENCE_PATH, {"global_last_human_input_at": ts})


def tty_last_active():
    latest = 0.0
    try:
        names = os.listdir("/dev/pts")
    except OSError:
        return 0.0
    for name in names:
        if not name.isdigit():
            continue
        try:
            atime = os.stat(os.path.join("/dev/pts", name)).st_atime
        except OSError:
            continue
        latest = max(latest, atime)
    return latest


def windows_last_active(config):
    if not config.get("presence", {}).get("windows_input", True) or not is_wsl():
        return None
    now = now_ts()
    cache = read_json(WIN_IDLE_CACHE, {}) or {}
    checked = float(cache.get("checked_at") or 0)
    if now - checked < WIN_IDLE_CACHE_TTL:
        idle = cache.get("idle_seconds")
        return checked - float(idle) if idle is not None else None

    exe = shutil.which("powershell.exe")
    idle = None
    if exe:
        try:
            result = subprocess.run(
                [exe, "-NoProfile", "-NonInteractive", "-Command", WIN_IDLE_PS],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=3,
            )
            if result.returncode == 0:
                idle = float(result.stdout.strip())
        except (OSError, subprocess.SubprocessError, ValueError):
            idle = None
    write_json_atomic(WIN_IDLE_CACHE, {"checked_at": now, "idle_seconds": idle})
    return now - idle if idle is not None else None


def presence_sources(config):
    sources = {"input": input_last_active(), "tty": tty_last_active()}
    win = windows_last_active(config)
    if win is not None:
        sources["windows"] = win
    return sources


def presence_idle(config):
    fake = os.environ.get("LLM_NOTIFY_FAKE_IDLE")
    if fake is not None:
        return float(fake)
    last = max(presence_sources(config).values())
    if last <= 0:
        return float("inf")
    return max(0.0, now_ts() - last)


def is_away(config):
    return presence_idle(config) >= config["presence"]["away_threshold"]


# --- claude process liveness ---
# SessionEnd never fires when the terminal is killed outright, so reply
# reminders also verify the claude process recorded at prompt time is
# still alive before going out. Start time guards against pid reuse.


def proc_stat_fields(pid):
    with open(f"/proc/{int(pid)}/stat", "r", encoding="ascii") as f:
        stat = f.read()
    return stat.rpartition(")")[2].split()  # [0]=state [1]=ppid [19]=starttime


def find_agent_pid():
    pid = os.getppid()
    for _ in range(10):
        if pid <= 1:
            return None
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv0 = f.read().split(b"\0", 1)[0].decode("utf-8", "replace")
            fields = proc_stat_fields(pid)
        except (OSError, IndexError, ValueError):
            return None
        if os.path.basename(argv0) == "claude":
            return pid, fields[19]
        pid = int(fields[1])
    return None


def agent_alive(session):
    pid = session.get("agent_pid")
    if not pid:
        return True  # never captured (e.g. no /proc); SessionEnd still covers
    try:
        fields = proc_stat_fields(pid)
    except (OSError, IndexError, ValueError):
        return False
    return fields[19] == str(session.get("agent_pid_start"))


# --- tool / event helpers ---


def norm_event(value):
    return re.sub(r"[^a-z0-9]", "", str(value or "").lower())


def get_event_name(info):
    return (
        info.get("hook_event_name")
        or info.get("event_name")
        or info.get("event")
        or ""
    )


def detect_tool(info, arg_tool=None):
    if arg_tool in ("claude", "codex"):
        return arg_tool
    explicit = str(info.get("tool") or info.get("source") or "").lower()
    if explicit in ("claude", "claude-code", "claude_code"):
        return "claude"
    if explicit == "codex":
        return "codex"
    if info.get("thread-id") or info.get("thread_id") or info.get("turn-id"):
        return "codex"
    if info.get("transcript_path") or info.get("permission_mode"):
        return "codex" if ".codex" in str(info.get("transcript_path") or "") else "claude"
    return "unknown"


def extract_session_id(info):
    return str(
        info.get("session_id")
        or info.get("session-id")
        or info.get("thread_id")
        or info.get("thread-id")
        or "unknown"
    )


def extract_cwd(info):
    cwd = info.get("cwd") or os.getcwd()
    return os.path.abspath(os.path.expanduser(str(cwd)))


def extract_prompt(info):
    value = info.get("prompt") or ""
    return value if isinstance(value, str) else ""


def project_label(cwd):
    name = os.path.basename(os.path.normpath(str(cwd))) if cwd else ""
    return name or "unknown"


# --- sessions ---


def session_path(tool, session_id):
    return os.path.join(SESSIONS_DIR, safe_state_name(f"{tool}__{session_id}") + ".json")


def load_session(tool, session_id):
    default = {
        "tool": tool,
        "session_id": session_id,
        "last_input_at": 0,
        "last_activity_at": 0,
        "last_intervention_sent_at": 0,
        "last_sent_turn": 0,
        "last_sent_reminder_at": 0,
        "closed_at": 0,
        "turn": None,
    }
    data = read_json(session_path(tool, session_id))
    if not isinstance(data, dict):
        return default
    for key, value in default.items():
        data.setdefault(key, value)
    return data


def save_session(session):
    write_json_atomic(session_path(session["tool"], session["session_id"]), session)


def mark_turn_sent(tool, session_id, started_at):
    session = load_session(tool, session_id)
    session["last_sent_turn"] = float(started_at)
    save_session(session)


def mark_intervention_sent(tool, session_id):
    session = load_session(tool, session_id)
    session["last_intervention_sent_at"] = now_ts()
    save_session(session)


def mark_reminder_sent(tool, session_id, fire_at):
    session = load_session(tool, session_id)
    session["last_sent_reminder_at"] = float(fire_at)
    save_session(session)


def gc_sessions():
    if not os.path.isdir(SESSIONS_DIR):
        return
    cutoff = now_ts() - SESSION_GC_AGE
    try:
        names = os.listdir(SESSIONS_DIR)
    except OSError:
        return
    for name in names:
        path = os.path.join(SESSIONS_DIR, name)
        try:
            if os.path.getmtime(path) < cutoff:
                os.unlink(path)
        except OSError:
            continue


# --- queue ---


def queue_entries():
    if not os.path.isdir(QUEUE_DIR):
        return []
    entries = []
    try:
        names = sorted(os.listdir(QUEUE_DIR))
    except OSError:
        return []
    for name in names:
        if not name.endswith(".json"):
            continue
        data = read_json(os.path.join(QUEUE_DIR, name))
        if isinstance(data, dict) and data.get("id"):
            entries.append(data)
    return entries


def queue_entry_path(entry_id):
    return os.path.join(QUEUE_DIR, safe_state_name(entry_id) + ".json")


def remove_entry(entry_id):
    try:
        os.unlink(queue_entry_path(entry_id))
    except OSError:
        pass


def save_entry(entry):
    write_json_atomic(queue_entry_path(entry["id"]), entry)


def enqueue(config, kind, state, tool, session_id, project, turn_started_at=None):
    created = now_ts()
    for entry in queue_entries():
        if entry.get("tool") != tool or entry.get("session_id") != session_id:
            continue
        if kind == "intervention" and entry.get("kind") == "intervention":
            return entry  # one pending intervention per session is enough
        if (
            kind == "completion"
            and entry.get("kind") == "completion"
            and entry.get("turn_started_at") == turn_started_at
        ):
            return entry  # same turn already queued
    entry = {
        "id": safe_state_name(f"{kind}__{tool}__{session_id}__{int(created * 1000)}"),
        "kind": kind,
        "state": state,
        "tool": tool,
        "session_id": session_id,
        "project": project,
        "created_at": created,
        "expires_at": created + config["notify"]["queue_ttl"],
        "attempts": 0,
    }
    if turn_started_at is not None:
        entry["turn_started_at"] = turn_started_at
    save_entry(entry)
    spawn_watcher()
    return entry


def schedule_reply_reminders(config, tool, session_id, project, anchor):
    """Queue cache-expiry reminders for a claude session now waiting on the user.

    Anchored at the last model activity (the cache clock resets there); the pair
    is replaced wholesale on every stop/intervention and cancelled by any reply,
    tool activity, SessionEnd, or the claude process dying.
    """
    if tool != "claude":
        return
    offsets = config["notify"]["reply_reminders"]
    if not offsets:
        return
    cancel_session_entries(tool, session_id, ("reminder",), "rescheduled")
    expires = anchor + config["notify"]["cache_ttl"]
    for offset in offsets:
        entry = {
            "id": safe_state_name(
                f"reminder__{tool}__{session_id}__{int(anchor * 1000)}__{int(offset)}"
            ),
            "kind": "reminder",
            "state": f"{int(offset) // 60}分钟未回复",
            "tool": tool,
            "session_id": session_id,
            "project": project,
            "created_at": anchor,
            "fire_at": anchor + offset,
            "expires_at": expires,
            "attempts": 0,
        }
        save_entry(entry)
    spawn_watcher()


def cancel_session_entries(tool, session_id, kinds, why):
    removed = 0
    for entry in queue_entries():
        if entry.get("tool") != tool or entry.get("session_id") != session_id:
            continue
        if entry.get("kind") not in kinds:
            continue
        remove_entry(entry["id"])
        removed += 1
        log_decision(
            "cancelled",
            kind=entry.get("kind"),
            tool=tool,
            session=session_id,
            reason=why,
        )
    return removed


def spawn_watcher():
    if os.environ.get("LLM_NOTIFY_NO_SPAWN") == "1":
        return
    try:
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "watch"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError:
        pass


# --- rendering / sending ---


def render_message(entries):
    parts = []
    for entry in entries:
        part = f"{entry.get('project') or 'unknown'} {entry.get('state') or '完成'}"
        if part not in parts:
            parts.append(part)
    return " · ".join(parts)


def send_batch(config, entries):
    if not try_send(config, render_message(entries)):
        return False
    for entry in entries:
        if entry.get("kind") == "intervention":
            mark_intervention_sent(entry["tool"], entry["session_id"])
        elif entry.get("kind") == "reminder":
            mark_reminder_sent(entry["tool"], entry["session_id"], entry.get("fire_at") or 0)
        elif entry.get("turn_started_at") is not None:
            mark_turn_sent(entry["tool"], entry["session_id"], entry["turn_started_at"])
    return True


# --- event handlers ---


def handle_prompt(info, tool, session_id):
    ts = now_ts()
    record_human_input(ts)
    # cancel first: even if this process is killed early, stale receipts are gone
    cancel_session_entries(
        tool, session_id, ("completion", "intervention", "reminder"), "session_continued"
    )
    session = load_session(tool, session_id)
    session["last_input_at"] = ts
    session["last_activity_at"] = ts
    session["turn"] = {
        "started_at": ts,
        "cwd": extract_cwd(info),
        "explicit_notify": bool(EXPLICIT_NOTIFY_RE.search(extract_prompt(info))),
    }
    if tool == "claude":
        found = find_agent_pid()
        if found:
            session["agent_pid"], session["agent_pid_start"] = found
    save_session(session)


def handle_tool_event(info, tool, session_id):
    session = load_session(tool, session_id)
    session["last_activity_at"] = now_ts()
    save_session(session)
    # the session is running again, so any pending "stuck on a prompt" alert is stale
    cancel_session_entries(tool, session_id, ("intervention",), "session_active")


def handle_stop(info, tool, session_id, config):
    completed = now_ts()
    session = load_session(tool, session_id)
    turn = session.get("turn")
    session["turn"] = None
    session["last_activity_at"] = completed
    save_session(session)

    if not isinstance(turn, dict):
        log_decision("suppressed", event="stop", tool=tool, session=session_id, reason="no_turn")
        return

    started = float(turn.get("started_at") or completed)
    project = project_label(turn.get("cwd"))
    # the session now waits on the user; short turns still leave a warm cache
    schedule_reply_reminders(config, tool, session_id, project, completed)

    if float(session.get("last_sent_turn") or 0) == started:
        log_decision("suppressed", event="stop", tool=tool, session=session_id, reason="already_sent")
        return

    if turn.get("explicit_notify"):
        if try_send(config, f"{project} 完成"):
            mark_turn_sent(tool, session_id, started)
            log_decision("sent_now", event="stop", tool=tool, session=session_id, reason="explicit")
        else:
            enqueue(config, "completion", "完成", tool, session_id, project, turn_started_at=started)
            log_decision("queued", event="stop", tool=tool, session=session_id, reason="send_failed")
        return

    elapsed = completed - started
    if elapsed < config["notify"]["min_elapsed"]:
        log_decision(
            "suppressed",
            event="stop",
            tool=tool,
            session=session_id,
            reason="short_turn",
            elapsed=round(elapsed, 1),
        )
        return

    enqueue(config, "completion", "完成", tool, session_id, project, turn_started_at=started)
    log_decision(
        "queued",
        event="stop",
        tool=tool,
        session=session_id,
        elapsed=round(elapsed, 1),
    )


def handle_intervention(info, tool, session_id, config, state):
    session = load_session(tool, session_id)
    turn = session.get("turn")
    cwd = turn.get("cwd") if isinstance(turn, dict) else extract_cwd(info)
    project = project_label(cwd)
    # scheduled even under cooldown: the session is stuck waiting either way
    schedule_reply_reminders(config, tool, session_id, project, now_ts())

    cooldown = config["notify"]["intervention_cooldown"]
    if now_ts() - float(session.get("last_intervention_sent_at") or 0) < cooldown:
        log_decision(
            "suppressed", event="intervention", tool=tool, session=session_id, reason="cooldown"
        )
        return

    enqueue(config, "intervention", state, tool, session_id, project)
    log_decision("queued", event="intervention", tool=tool, session=session_id, state=state)


def handle_session_end(info, tool, session_id):
    # cancel first, same crash-safety reasoning as handle_prompt
    cancel_session_entries(
        tool, session_id, ("completion", "intervention", "reminder"), "session_closed"
    )
    session = load_session(tool, session_id)
    session["closed_at"] = now_ts()
    session["turn"] = None
    save_session(session)
    log_decision(
        "closed", event="sessionend", tool=tool, session=session_id,
        reason=str(info.get("reason") or ""),
    )


def handle_event(info, arg_tool=None):
    tool = detect_tool(info, arg_tool)
    event = norm_event(get_event_name(info))
    session_id = extract_session_id(info)

    if event == "userpromptsubmit":
        handle_prompt(info, tool, session_id)
        return

    if event in ("posttooluse", "posttoolusefailure"):
        handle_tool_event(info, tool, session_id)
        return

    if event == "sessionend":
        handle_session_end(info, tool, session_id)
        return

    config = load_config(required=False)

    if event == "notification":
        ntype = str(info.get("notification_type") or "")
        state = INTERVENTION_TYPES.get(ntype)
        if state is None:
            log_decision(
                "ignored", event="notification", tool=tool, session=session_id, ntype=ntype
            )
            return
        handle_intervention(info, tool, session_id, config, state)
        return

    if event == "stopfailure":
        handle_intervention(info, tool, session_id, config, "出错")
        return

    if event == "stop":
        handle_stop(info, tool, session_id, config)
        return


# --- watcher ---


def acquire_watcher_lock():
    if fcntl is None:
        return None
    ensure_state_dirs()
    try:
        fd = os.open(WATCHER_LOCK, os.O_CREAT | os.O_RDWR, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        try:
            os.close(fd)
        except (OSError, UnboundLocalError):
            pass
        return None
    os.ftruncate(fd, 0)
    os.write(fd, str(os.getpid()).encode("ascii"))
    return fd


def watcher_running():
    if fcntl is None or not os.path.exists(WATCHER_LOCK):
        return False
    try:
        fd = os.open(WATCHER_LOCK, os.O_RDWR)
    except OSError:
        return False
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        fcntl.flock(fd, fcntl.LOCK_UN)
        return False
    except OSError:
        return True
    finally:
        os.close(fd)


def sweep_queue(config, present):
    """Drop entries that are stale, seen, or expired; return the survivors."""
    live = []
    now = now_ts()
    seen_grace = config["notify"]["seen_grace"]
    for entry in queue_entries():
        session = load_session(entry.get("tool"), entry.get("session_id"))
        created = float(entry.get("created_at") or 0)
        kind = entry.get("kind")
        if kind == "completion":
            if float(session.get("last_input_at") or 0) > created:
                remove_entry(entry["id"])
                log_decision("cancelled", kind=kind, session=entry.get("session_id"), reason="session_continued")
                continue
            if float(session.get("last_sent_turn") or 0) == float(entry.get("turn_started_at") or -1):
                remove_entry(entry["id"])
                log_decision("cancelled", kind=kind, session=entry.get("session_id"), reason="already_sent")
                continue
            if present and now - created >= seen_grace:
                remove_entry(entry["id"])
                log_decision("cancelled", kind=kind, session=entry.get("session_id"), reason="seen")
                continue
        if kind == "intervention" and float(session.get("last_activity_at") or 0) > created:
            remove_entry(entry["id"])
            log_decision("cancelled", kind=kind, session=entry.get("session_id"), reason="session_active")
            continue
        if kind == "reminder":
            # created_at is the anchor: the last model activity that reset the cache
            reason = None
            if float(session.get("closed_at") or 0) > created:
                reason = "session_closed"
            elif float(session.get("last_activity_at") or 0) > created:
                reason = "session_active"
            elif float(session.get("last_sent_reminder_at") or 0) == float(entry.get("fire_at") or -1):
                reason = "already_sent"
            elif not agent_alive(session):
                reason = "session_gone"
            if reason:
                remove_entry(entry["id"])
                log_decision("cancelled", kind=kind, session=entry.get("session_id"), reason=reason)
                continue
        if now >= float(entry.get("expires_at") or 0):
            remove_entry(entry["id"])
            log_decision("expired", kind=kind, session=entry.get("session_id"))
            continue
        live.append(entry)
    return live


def cmd_watch():
    lock_fd = acquire_watcher_lock()
    if lock_fd is None:
        return
    config = load_config(required=False)
    if not config.get("webhook"):
        return
    gc_sessions()
    debounce = config["notify"]["debounce"]
    while True:
        away = is_away(config)
        entries = sweep_queue(config, present=not away)
        if not entries:
            return
        now = now_ts()
        # due reminders bypass the presence gate: they are time-critical
        # (cache expiry), and their main audience is a present-but-busy user
        due = [
            e for e in entries
            if e.get("kind") == "reminder" and now >= float(e.get("fire_at") or 0)
        ]
        if due:
            if send_batch(config, due):
                for entry in due:
                    remove_entry(entry["id"])
                log_decision("sent_batch", count=len(due), kind="reminder")
            else:
                for entry in due:
                    entry["attempts"] = int(entry.get("attempts", 0)) + 1
                    if entry["attempts"] > 3:
                        remove_entry(entry["id"])
                        log_decision("failed", kind="reminder", session=entry.get("session_id"))
                    else:
                        save_entry(entry)
                time.sleep(max(WATCH_POLL, 60))
            continue
        waiting = [e for e in entries if e.get("kind") != "reminder"]
        if not away or not waiting:
            time.sleep(WATCH_POLL)
            continue
        newest = max(float(e.get("created_at") or 0) for e in waiting)
        oldest = min(float(e.get("created_at") or 0) for e in waiting)
        if now - newest < debounce and now - oldest < DEBOUNCE_CAP:
            time.sleep(WATCH_POLL)  # more entries may be about to arrive; coalesce
            continue
        if send_batch(config, waiting):
            for entry in waiting:
                remove_entry(entry["id"])
            log_decision("sent_batch", count=len(waiting))
            continue  # rescan: new entries may have arrived while we held the lock
        for entry in waiting:
            entry["attempts"] = int(entry.get("attempts", 0)) + 1
            if entry["attempts"] > 3:
                remove_entry(entry["id"])
                log_decision("failed", kind=entry.get("kind"), session=entry.get("session_id"))
            else:
                save_entry(entry)
        time.sleep(max(WATCH_POLL, 60))



def cmd_status():
    config = load_config(required=False)
    fake = os.environ.get("LLM_NOTIFY_FAKE_IDLE")

    print("== presence ==")
    sources = presence_sources(config)
    for name in ("input", "tty", "windows"):
        if name in sources:
            ts = sources[name]
            ago = f"{now_ts() - ts:7.0f}s 前" if ts > 0 else "   无信号"
            print(f"  {name:8s} 最近活动: {ago}")
        elif name == "windows":
            why = "非 WSL" if not is_wsl() else ("已禁用" if not config["presence"].get("windows_input") else "探测失败")
            print(f"  {name:8s} 不可用 ({why})")
    idle = presence_idle(config)
    threshold = config["presence"]["away_threshold"]
    state = "离开" if idle >= threshold else "在场"
    suffix = " [FAKE_IDLE]" if fake is not None else ""
    idle_text = "inf" if idle == float("inf") else f"{idle:.0f}s"
    print(f"  判定: {state} (idle={idle_text}, away_threshold={threshold}s){suffix}")

    print("\n== queue ==")
    entries = queue_entries()
    if not entries:
        print("  (空)")
    for entry in entries:
        age = now_ts() - float(entry.get("created_at") or 0)
        left = float(entry.get("expires_at") or 0) - now_ts()
        line = (
            f"  {entry.get('kind'):12s} {entry.get('project') or 'unknown':20s} "
            f"{entry.get('state') or '完成':6s} 等待 {age:5.0f}s, TTL 剩 {max(0, left):5.0f}s"
        )
        if entry.get("fire_at") is not None:
            line += f", 距触发 {max(0, float(entry['fire_at']) - now_ts()):5.0f}s"
        print(line)

    print(f"\n== watcher ==\n  {'运行中' if watcher_running() else '未运行'}")

    print("\n== 最近决策 ==")
    lines = []
    try:
        with open(LOG_PATH, "r", encoding="utf-8", errors="replace") as f:
            lines = f.readlines()[-10:]
    except OSError:
        pass
    if not lines:
        print("  (无记录)")
    for line in lines:
        try:
            rec = json.loads(line)
        except json.JSONDecodeError:
            continue
        ts = time.strftime("%m-%d %H:%M:%S", time.localtime(rec.get("ts", 0)))
        detail = {k: v for k, v in rec.items() if k not in ("ts", "decision")}
        print(f"  {ts} {rec.get('decision', '?'):10s} {json.dumps(detail, ensure_ascii=False)}")



def handle_prompt(info, tool, session_id):
    ts = now_ts()
    record_human_input(ts)
    session = load_session(tool, session_id)
    session["last_input_at"] = ts
    session["last_activity_at"] = ts
    cwd = extract_cwd(info)
    turn = {
        "tool": tool,
        "session_id": session_id,
        "started_at": ts,
        "cwd": cwd,
        "tool_count": 0,
        "failure_count": 0,
        "explicit_notify": bool(EXPLICIT_NOTIFY_RE.search(extract_prompt(info))),
        "file_candidates": [],
    }
    turn.update(git_snapshot(cwd))
    session["turn"] = turn
    save_session(session)
    cancel_session_entries(tool, session_id, ("completion", "intervention"), "session_continued")


def handle_tool_event(info, tool, session_id, failed):
    session = load_session(tool, session_id)
    session["last_activity_at"] = now_ts()
    turn = session.get("turn")
    if isinstance(turn, dict):
        turn["tool_count"] = int(turn.get("tool_count", 0)) + 1
        if failed:
            turn["failure_count"] = int(turn.get("failure_count", 0)) + 1
        name = tool_name_from_info(info)
        if name in EDIT_TOOLS:
            tool_input = tool_input_from_info(info)
            path = tool_input.get("file_path") or tool_input.get("path")
            if path:
                path = str(path)
                candidates = set(turn.get("file_candidates") or [])
                candidates.add(os.path.basename(path) if os.path.isabs(path) else path)
                turn["file_candidates"] = sorted(candidates)
    save_session(session)
    # the session is running again, so any pending "stuck on a prompt" alert is stale
    cancel_session_entries(tool, session_id, ("intervention",), "session_active")


def handle_stop(info, tool, session_id, config):
    completed = now_ts()
    session = load_session(tool, session_id)
    turn = session.get("turn")
    session["turn"] = None
    session["last_activity_at"] = completed
    save_session(session)

    if not isinstance(turn, dict):
        log_decision("suppressed", event="stop", tool=tool, session=session_id, reason="no_turn")
        return

    snap = dict(turn)
    snap["completed_at"] = completed
    elapsed = completed - float(turn.get("started_at") or completed)

    if turn.get("explicit_notify"):
        if not send_completion_now(config, snap, "显式要求通知"):
            enqueue(config, "completion", tool, session_id, snapshot=snap)
        log_decision("sent_now", event="stop", tool=tool, session=session_id, reason="explicit")
        return

    if elapsed < config["notify"]["min_elapsed"]:
        log_decision(
            "suppressed",
            event="stop",
            tool=tool,
            session=session_id,
            reason="short_turn",
            elapsed=round(elapsed, 1),
        )
        return

    if is_away(config):
        if send_completion_now(config, snap, "离开时完成"):
            log_decision("sent_now", event="stop", tool=tool, session=session_id, reason="away")
        else:
            enqueue(config, "completion", tool, session_id, snapshot=snap)
            log_decision("queued", event="stop", tool=tool, session=session_id, reason="send_failed")
        return

    enqueue(config, "completion", tool, session_id, snapshot=snap)
    log_decision(
        "queued",
        event="stop",
        tool=tool,
        session=session_id,
        reason="present",
        elapsed=round(elapsed, 1),
    )


def handle_intervention(info, tool, session_id, config, reason):
    session = load_session(tool, session_id)
    cooldown = config["notify"]["intervention_cooldown"]
    if now_ts() - float(session.get("last_intervention_sent_at") or 0) < cooldown:
        log_decision(
            "suppressed", event="intervention", tool=tool, session=session_id, reason="cooldown"
        )
        return

    snap = session.get("turn") if isinstance(session.get("turn"), dict) else {"cwd": extract_cwd(info)}
    if is_away(config):
        if send_intervention_now(config, tool, reason, snap):
            mark_intervention_sent(tool, session_id)
            log_decision(
                "sent_now", event="intervention", tool=tool, session=session_id, reason=reason
            )
            return
    enqueue(config, "intervention", tool, session_id, reason=reason, snapshot=snap)
    log_decision("queued", event="intervention", tool=tool, session=session_id, reason=reason)


def handle_event(info, arg_tool=None):
    tool = detect_tool(info, arg_tool)
    event = norm_event(get_event_name(info))
    session_id = extract_session_id(info)

    if event == "userpromptsubmit":
        handle_prompt(info, tool, session_id)
        return

    if event == "posttooluse":
        handle_tool_event(info, tool, session_id, failed=False)
        return

    if event == "posttoolusefailure":
        handle_tool_event(info, tool, session_id, failed=True)
        return

    config = load_config(required=False)

    if event == "notification":
        ntype = str(info.get("notification_type") or "")
        reason = INTERVENTION_TYPES.get(ntype)
        if reason is None:
            log_decision(
                "ignored", event="notification", tool=tool, session=session_id, ntype=ntype
            )
            return
        handle_intervention(info, tool, session_id, config, reason)
        return

    if event == "stopfailure":
        handle_intervention(info, tool, session_id, config, classify_stop_failure(info))
        return

    if event == "stop":
        handle_stop(info, tool, session_id, config)
        return


# --- watcher ---


def acquire_watcher_lock():
    if fcntl is None:
        return None
    ensure_state_dirs()
    try:
        fd = os.open(WATCHER_LOCK, os.O_CREAT | os.O_RDWR, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        try:
            os.close(fd)
        except (OSError, UnboundLocalError):
            pass
        return None
    os.ftruncate(fd, 0)
    os.write(fd, str(os.getpid()).encode("ascii"))
    return fd


def watcher_running():
    if fcntl is None or not os.path.exists(WATCHER_LOCK):
        return False
    try:
        fd = os.open(WATCHER_LOCK, os.O_RDWR)
    except OSError:
        return False
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        fcntl.flock(fd, fcntl.LOCK_UN)
        return False
    except OSError:
        return True
    finally:
        os.close(fd)


def sweep_queue(config):
    """Drop entries that are stale, seen, or expired; return the survivors."""
    live = []
    for entry in queue_entries():
        session = load_session(entry.get("tool"), entry.get("session_id"))
        created = float(entry.get("created_at") or 0)
        if entry.get("kind") == "completion" and float(session.get("last_input_at") or 0) > created:
            remove_entry(entry["id"])
            log_decision("cancelled", kind="completion", session=entry.get("session_id"), reason="session_continued")
            continue
        if entry.get("kind") == "intervention" and float(session.get("last_activity_at") or 0) > created:
            remove_entry(entry["id"])
            log_decision("cancelled", kind="intervention", session=entry.get("session_id"), reason="session_active")
            continue
        if now_ts() >= float(entry.get("expires_at") or 0):
            remove_entry(entry["id"])
            log_decision("expired", kind=entry.get("kind"), session=entry.get("session_id"))
            continue
        live.append(entry)
    return live


def cmd_watch():
    lock_fd = acquire_watcher_lock()
    if lock_fd is None:
        return
    config = load_config(required=False)
    if not config.get("webhook"):
        return
    gc_sessions()
    while True:
        entries = sweep_queue(config)
        if not entries:
            return
        if not is_away(config):
            time.sleep(WATCH_POLL)
            continue
        if send_batch(config, entries):
            for entry in entries:
                remove_entry(entry["id"])
            log_decision("sent_batch", count=len(entries))
            continue  # rescan: new entries may have arrived while we held the lock
        for entry in entries:
            entry["attempts"] = int(entry.get("attempts", 0)) + 1
            if entry["attempts"] > 3:
                remove_entry(entry["id"])
                log_decision("failed", kind=entry.get("kind"), session=entry.get("session_id"))
            else:
                save_entry(entry)
        time.sleep(max(WATCH_POLL, 60))


